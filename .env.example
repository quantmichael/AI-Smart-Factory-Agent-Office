APP_ENV=development
APP_NAME=ai-smart-factory-agent-office-api
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

OPENAI_API_KEY=

PADERBORN_DATA_ROOT=../data/paderborn
KNOWLEDGE_BASE_ROOT=../knowledge
MODEL_ROOT=../models
ML_ARTIFACT_ROOT=../artifacts/ml
ACTIVE_ML_MODEL_ID=bearing_rf_binary_v1

DATABASE_URL=sqlite:///./app.db
VECTOR_DB_PATH=../artifacts/vector_db
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sklearn-hashing-vectorizer-v1
EMBEDDING_BATCH_SIZE=64
AGENT_CHECKPOINT_PATH=../artifacts/agent/checkpoints/langgraph_core.sqlite3
AGENT_RUN_DB_PATH=../artifacts/api/runtime/agent_runs.sqlite3
EQUIPMENT_MEMORY_DB_PATH=../artifacts/memory/equipment_memory.sqlite3
INSPECTION_IMAGE_DB_PATH=../artifacts/multimodal/inspection_images.sqlite3
INSPECTION_UPLOAD_ROOT=../artifacts/multimodal/uploads
VISION_ENABLED=true
VISION_MODEL=pillow-quality-observer-v1
MAX_IMAGE_SIZE_MB=8
MAX_IMAGE_DIMENSION=4096
AGENT_BACKGROUND_WORKERS=4
SSE_POLL_INTERVAL_SECONDS=0.1
SSE_HEARTBEAT_SECONDS=15
MAX_RETRIEVAL_RETRIES=2
MAX_HUMAN_INFORMATION_ROUNDS=2
MAX_ACTION_REVISION_ROUNDS=1
KNOWLEDGE_PACK_ID=bearing_v1
WORKFLOW_VERSION=diagnosis_core_v1
STARTUP_VALIDATION_STRICT=false

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
